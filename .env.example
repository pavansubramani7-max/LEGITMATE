# LEGITMATE local configuration
# Copy this file to .env and fill in the required values before starting the server.
#
# REQUIRED — the server will refuse to start without these two variables.
#
# LEGITMATE_PASSWORD: seeds the first administrator account on first login.
#   Use a unique password with at least 12 characters. Customers are created
#   individually from the admin account panel. Do not commit this file.
#   Example (do not use this value):
# LEGITMATE_PASSWORD=change-me-before-use
# LEGITMATE_ADMIN_USERNAME=admin
# LEGITMATE_ADMIN_NAME=Workspace administrator
#
# LEGITMATE_SECRET: a random secret used to sign session cookies.
#   Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
#   Do not commit this value to source control.
# LEGITMATE_SECRET=replace-with-64-hex-chars
#
# OPTIONAL
#
# Session lifetime in seconds (default: 28800 = 8 hours)
# LEGITMATE_SESSION_MAX_AGE=28800
#
# Bind address (default: 127.0.0.1 — do not change to 0.0.0.0 on shared networks)
# HOST=127.0.0.1
# PORT=8000

# OPTIONAL — change the multilingual E5 encoder only after evaluating a trained candidate.
# Default remains intfloat/multilingual-e5-small. Candidate example:
# LEGITMATE_EMBEDDING_MODEL=models/e5-kaggle-mix-candidate

# OPTIONAL — choose whether external AI providers are available.
# Default is off (local-only); set AI_PROVIDER=gemini, groq, or auto to enable.
# auto selects Gemini when GEMINI_API_KEY is set; otherwise it selects Groq.
# A Google AI Pro subscription is separate from Gemini API access. Create an API
# key in Google AI Studio and check its project quota/billing before use.
# AI_PROVIDER=off
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash
# Live-chat network timeout in seconds (default: 45; accepted range: 15–90)
# GEMINI_CHAT_TIMEOUT_SECONDS=45
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-20b
# Live chat sends your message plus recent chat turns. Document AI sends the
# question plus retrieved excerpts. The original PDF/DOCX file is never sent.
#
# DATA STORAGE NOTE
# The initial admin keeps existing data/documents/ and data/index.json.
# Customer files and indexes are isolated under data/workspaces/<account-id>/.
# Documents and embedding caches are plain local files with no encryption at rest.
# OS-level file permissions are the only protection outside this process.
# Do not store sensitive real documents on a shared or unencrypted drive.
